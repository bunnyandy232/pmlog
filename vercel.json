{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/", "destination": "/prototypes/" },
    { "source": "/app/", "destination": "/prototypes/app.html" },
    { "source": "/app.html", "destination": "/prototypes/app.html" },
    { "source": "/app.css", "destination": "/prototypes/app.css" },
    { "source": "/app.js", "destination": "/prototypes/app.js" },
    { "source": "/data.js", "destination": "/prototypes/data.js" },
    { "source": "/auth.js", "destination": "/prototypes/auth.js" },
    { "source": "/store.js", "destination": "/prototypes/store.js" },
    { "source": "/supabase-client.js", "destination": "/prototypes/supabase-client.js" },
    { "source": "/config.js", "destination": "/prototypes/config.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
